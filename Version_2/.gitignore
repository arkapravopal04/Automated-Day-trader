# --- Secrets ---
.env
*.env
*.env.*

# --- Private keys, certs, API tokens ---
*.pem
*.key
kaggle.json
!.env.example

# --- Runtime data (regenerated locally / on Kaggle, never committed) ---
data/
checkpoints/
logs/
backtest_output/
backtest_output_*/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

sweep_output/
kaggle_data/

# --- Local-only agent/session notes ---
AGENTS.md

# --- Virtual environments ---
venv/
.venv/
env/bin/
env/lib/
env/pyvenv.cfg

# --- Jupyter / Kaggle notebooks ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Model artifacts that shouldn't live in git (use Kaggle Datasets / releases instead) ---
*.pt
*.pth
*.ckpt
*.pkl